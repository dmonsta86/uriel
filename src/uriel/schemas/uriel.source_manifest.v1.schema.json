{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uriel.dev/schemas/uriel.source_manifest.v1.schema.json",
  "title": "Uriel Source Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "project_id",
    "generated_at_utc",
    "root_binding_sha256",
    "record_count",
    "records_sha256",
    "records",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "uriel.source_manifest.v1"
    },
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "root_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256",
          "size",
          "media_type"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
