{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uriel.dev/schemas/uriel.audit.v1.schema.json",
  "title": "Uriel Audit Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "audit_id",
    "profile",
    "status",
    "created_at_utc",
    "source_manifest_sha256",
    "source_records_sha256",
    "project_manifest_sha256",
    "policy_version",
    "gates",
    "audit_path",
    "blessable",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "uriel.audit.v1"
    },
    "schema_version": {
      "const": 1
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "profile": {
      "enum": [
        "exploratory",
        "standard",
        "strict",
        "submission"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "created_at_utc": {
      "type": "string"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_records_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_version": {
      "type": "string"
    },
    "audit_path": {
      "type": "string"
    },
    "blessable": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "gate",
          "name",
          "status",
          "scope_note",
          "blocker_count",
          "warning_count",
          "findings"
        ],
        "properties": {
          "gate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "scope_note": {
            "type": "string"
          },
          "blocker_count": {
            "type": "integer",
            "minimum": 0
          },
          "warning_count": {
            "type": "integer",
            "minimum": 0
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
