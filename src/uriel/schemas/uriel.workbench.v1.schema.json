{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uriel.workbench.v1",
  "title": "Uriel Workbench record",
  "description": "Diamond Path record store: recovered question, labeled items, rival explanations, minimum viable research design, pivots, and audit path. Every update is a new immutable generation.",
  "type": "object",
  "required": [
    "schema",
    "workbench_id",
    "created_at_utc",
    "generation_id",
    "question",
    "items",
    "rival_explanations",
    "design",
    "pivots",
    "audit_path",
    "status"
  ],
  "properties": {
    "schema": { "const": "uriel.workbench.v1" },
    "workbench_id": { "type": "string", "pattern": "^wb-[0-9a-f]{16}$" },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "generation_id": { "type": "string", "pattern": "^wbgen-[0-9a-f]{16}$" },
    "question": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^item-[0-9a-f]{12}$" },
          "label": {
            "type": "string",
            "enum": [
              "OBSERVATION",
              "INTERPRETATION",
              "CLAIM",
              "ASSUMPTION",
              "UNKNOWN",
              "PROPOSED TEST"
            ]
          },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rival_explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^rival-[0-9a-f]{12}$" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "hypothesis": { "type": ["string", "null"] },
        "rival_hypothesis": { "type": ["string", "null"] },
        "variables": { "type": ["string", "null"] },
        "operational_definitions": { "type": ["string", "null"] },
        "controls": { "type": ["string", "null"] },
        "inclusion_exclusion": { "type": ["string", "null"] },
        "minimum_useful_data": { "type": ["string", "null"] },
        "falsifying_result": { "type": ["string", "null"] },
        "stopping_rule": { "type": ["string", "null"] },
        "ethics_privacy": { "type": ["string", "null"] }
      }
    },
    "pivots": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "narrower claim",
          "different outcome",
          "different comparison",
          "observational study",
          "replication",
          "methods paper",
          "dataset/resource paper",
          "negative result",
          "software/tool paper",
          "review or evidence map"
        ]
      }
    },
    "audit_path": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "must_be_true_before_pass"],
        "properties": {
          "gate": { "type": "string" },
          "must_be_true_before_pass": { "type": "string" }
        }
      }
    },
    "user_decision": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["open", "pivoted"] }
  }
}
