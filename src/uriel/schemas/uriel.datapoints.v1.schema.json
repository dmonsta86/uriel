{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmonsta86/uriel/schemas/uriel.datapoints.v1.schema.json",
  "title": "Uriel Datapoint Registry",
  "type": "object",
  "required": [
    "schema",
    "datapoints"
  ],
  "properties": {
    "schema": {
      "const": "uriel.datapoints.v1"
    },
    "schema_version": {
      "const": 1
    },
    "datapoints": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "artifact_path",
          "sha256",
          "locator",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 8
          },
          "artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "locator": {
            "$ref": "#/$defs/locator"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "source_token": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "count",
              "proportion",
              "percent",
              "p_value",
              "correlation",
              "mean",
              "median",
              "sd",
              "se",
              "variance",
              "estimate",
              "ci_bound",
              "statistic",
              "ratio",
              "text",
              "other"
            ]
          },
          "format": {
            "type": "string",
            "pattern": "^(raw|d|,d|apa_p|,?\\.\\d{1,2}[f%]~?)$"
          },
          "unit": {
            "type": "string"
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_id": {
            "type": "string"
          },
          "grim": {
            "type": "object",
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "provenance": {
            "type": "string"
          },
          "registered_at_utc": {
            "type": "string"
          },
          "refreshed_at_utc": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "parts",
              "total"
            ],
            "properties": {
              "type": {
                "const": "sum"
              },
              "parts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "total": {
                "type": "string"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "numerator",
              "denominator",
              "result"
            ],
            "properties": {
              "type": {
                "const": "ratio"
              },
              "numerator": {
                "type": "string"
              },
              "denominator": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "scale": {
                "type": "number"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "lower",
              "estimate",
              "upper"
            ],
            "properties": {
              "type": {
                "const": "ci"
              },
              "lower": {
                "type": "string"
              },
              "estimate": {
                "type": "string"
              },
              "upper": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "left",
              "right"
            ],
            "properties": {
              "type": {
                "const": "le"
              },
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "ids"
            ],
            "properties": {
              "type": {
                "const": "equal"
              },
              "ids": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "column"
          ],
          "properties": {
            "type": {
              "const": "csv_cell"
            },
            "column": {
              "type": "string"
            },
            "row": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            },
            "row_index": {
              "type": "integer",
              "minimum": 0
            },
            "delimiter": {
              "enum": [
                ",",
                "\t",
                ";",
                "|"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "pointer"
          ],
          "properties": {
            "type": {
              "const": "json_pointer"
            },
            "pointer": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "pattern"
          ],
          "properties": {
            "type": {
              "const": "text_regex"
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
