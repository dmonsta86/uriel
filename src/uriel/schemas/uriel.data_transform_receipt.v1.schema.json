{
  "$id": "uriel.data_transform_receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Data Normalization and Transform Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "created_at_utc",
    "input_generation_id",
    "output_generation_id",
    "transform_kind",
    "rule_set_sha256",
    "rows_before",
    "rows_after",
    "lossless",
    "source_mutated",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.data_transform_receipt.v1"},
    "schema_version": {"const": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "input_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transform_kind": {"enum": ["NORMALIZE", "PROJECT", "FILTER", "SORT", "TYPE_COERCE"]},
    "rule_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows_before": {"type": "integer", "minimum": 0},
    "rows_after": {"type": "integer", "minimum": 0},
    "lossless": {"type": "boolean"},
    "source_mutated": {"const": false},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
