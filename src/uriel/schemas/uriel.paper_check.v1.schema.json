{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmonsta86/uriel/schemas/uriel.paper_check.v1.schema.json",
  "title": "Uriel Paper Check Report",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "profile",
    "status",
    "created_at_utc",
    "project_sha256",
    "paper",
    "inputs",
    "datapoints",
    "references",
    "claims",
    "statistics",
    "plan",
    "blocker_count",
    "warning_count",
    "findings",
    "boundaries",
    "report_sha256"
  ],
  "properties": {
    "schema": {
      "const": "uriel.paper_check.v1"
    },
    "schema_version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "draft",
        "submission"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "created_at_utc": {
      "type": "string"
    },
    "project_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "blocker_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "scientific_truth_decided": {
          "const": false
        },
        "writes": {
          "const": 0
        }
      }
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "level",
        "severity",
        "status",
        "subject",
        "message",
        "location",
        "repairs"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "level": {
          "enum": [
            "grave",
            "submission",
            "style"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "warning"
          ]
        },
        "status": {
          "enum": [
            "FAIL",
            "WARN"
          ]
        },
        "subject": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "properties": {
            "file": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "excerpt": {
          "type": "string"
        },
        "detail": {
          "type": "object"
        },
        "repairs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
