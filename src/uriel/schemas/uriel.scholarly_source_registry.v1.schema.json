{
  "$id": "uriel.scholarly_source_registry.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Scholarly Source Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_version",
    "registry_id",
    "status",
    "live_network_enabled",
    "generic_browsing_enabled",
    "entries",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.scholarly_source_registry.v1"},
    "schema_version": {"const": 1},
    "policy_version": {"const": "uriel.scholarly_acquisition_policy.v1"},
    "registry_id": {"const": "uriel-local-mock-registry-v1"},
    "status": {"const": "TEST_ONLY"},
    "live_network_enabled": {"const": false},
    "generic_browsing_enabled": {"const": false},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_record_sha256"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
