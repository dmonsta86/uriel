{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "uriel.gap_register.v1",
    "title": "Uriel structured gap register",
    "description": "One structured gap register with all contract fields and action labels.",
    "type": "object",
    "required": ["schema", "schema_version", "label", "created_at_utc", "gap_count", "register_sha256", "gaps"],
    "properties": {
        "schema": { "const": "uriel.gap_register.v1" },
        "schema_version": { "const": 1 },
        "label": { "type": "string" },
        "created_at_utc": { "type": "string", "format": "date-time" },
        "gap_count": { "type": "integer", "minimum": 1 },
        "register_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "gaps": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["gap_id", "gate", "failure_code", "severity", "observed_fact", "why_it_matters", "status", "action"],
                "properties": {
                    "gap_id": { "type": "string" },
                    "gate": { "type": "integer", "minimum": 0, "maximum": 3 },
                    "failure_code": { "type": "string" },
                    "severity": {
                        "type": "string",
                        "enum": ["FATAL", "BLOCKING", "SCOPE_LIMITING", "NONBLOCKING", "INFORMATIONAL"]
                    },
                    "observed_fact": { "type": "string" },
                    "why_it_matters": { "type": "string" },
                    "affected_claims": { "type": "array", "items": { "type": "string" } },
                    "affected_artifacts": { "type": "array", "items": { "type": "string" } },
                    "what_remains_valid": { "type": "string" },
                    "minimum_repair": { "type": "string" },
                    "preferred_repair": { "type": "string" },
                    "alternative_repairs": { "type": "array", "items": { "type": "string" } },
                    "best_sorting_or_collection_method": { "type": "string" },
                    "evidence_needed": { "type": "string" },
                    "user_action_needed": { "type": "string" },
                    "uriel_action_available": { "type": "string" },
                    "external_action_needed": { "type": "string" },
                    "completion_condition": { "type": "string" },
                    "verification_command": { "type": "string" },
                    "status": { "type": "string", "enum": ["open", "resolved", "rejected"] },
                    "action": {
                        "type": "string",
                        "enum": [
                            "FILLED_BY_URIEL",
                            "REQUIRES_USER_DECISION",
                            "REQUIRES_SOURCE_ARTIFACT",
                            "REQUIRES_NEW_DATA",
                            "REQUIRES_EXPERIMENT",
                            "REQUIRES_EXTERNAL_VERIFICATION",
                            "UNRESOLVABLE_AS_STATED"
                        ]
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
