{
  "$id": "uriel.resource_budget.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Data Desk Resource Budget v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_version",
    "max_source_bytes",
    "max_records",
    "max_columns",
    "max_nesting_depth",
    "max_field_bytes",
    "timeout_seconds",
    "record_sha256"
  ],
  "properties": {
    "schema": {
      "const": "uriel.resource_budget.v2"
    },
    "schema_version": {
      "const": 2
    },
    "policy_version": {
      "const": "uriel.data_policy.v1"
    },
    "max_source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "max_columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_nesting_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "max_field_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
