{
  "$id": "uriel.scholarly_receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Scholarly Local-Mock Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "created_at_utc",
    "policy_version",
    "plan_record_sha256",
    "registry_record_sha256",
    "source_record_sha256",
    "query_record_sha256",
    "budget_record_sha256",
    "adapter_record_sha256",
    "request_descriptor_sha256",
    "quarantine_record_sha256",
    "body_content_sha256",
    "body_size_bytes",
    "managed_relative_path",
    "mock_trace",
    "decision",
    "independent_quarantine_verification",
    "quarantine_complete",
    "network_permitted",
    "live_adapter_enabled",
    "parsed",
    "readiness_authority_granted",
    "gate_authority_granted",
    "publication_authority_granted",
    "blessing_authority_granted",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.scholarly_receipt.v1"},
    "schema_version": {"const": 1},
    "created_at_utc": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_version": {"const": "uriel.scholarly_acquisition_policy.v1"},
    "plan_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_descriptor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quarantine_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "managed_relative_path": {"type": "string", "minLength": 1, "maxLength": 256},
    "mock_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "simulated_dns_answers",
        "connected_address",
        "peer_hostname",
        "attempt_count",
        "elapsed_ms",
        "response_status",
        "response_headers",
        "headers_sha256",
        "body_content_sha256",
        "body_size_bytes",
        "proxy_used",
        "credentials_used",
        "background_threads_started",
        "network_calls",
        "resolver_calls",
        "redirect_count"
      ],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "simulated_dns_answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "connected_address": {"type": "string", "minLength": 1, "maxLength": 64},
        "peer_hostname": {"const": "mock.invalid"},
        "attempt_count": {"const": 1},
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
        "response_status": {"const": 200},
        "response_headers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {"enum": ["content-encoding", "content-length", "content-type"]},
              "value": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        },
        "headers_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "body_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "body_size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "proxy_used": {"const": false},
        "credentials_used": {"const": false},
        "background_threads_started": {"const": 0},
        "network_calls": {"const": 0},
        "resolver_calls": {"const": 0},
        "redirect_count": {"const": 0}
      }
    },
    "decision": {"const": "PASS_LOCAL_MOCK"},
    "independent_quarantine_verification": {"const": "PASS"},
    "quarantine_complete": {"const": true},
    "network_permitted": {"const": false},
    "live_adapter_enabled": {"const": false},
    "parsed": {"const": false},
    "readiness_authority_granted": {"const": false},
    "gate_authority_granted": {"const": false},
    "publication_authority_granted": {"const": false},
    "blessing_authority_granted": {"const": false},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
