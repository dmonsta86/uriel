{
  "$id": "uriel.scholarly_adapter.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Scholarly Adapter Interface v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_version",
    "adapter_id",
    "transport_kind",
    "injected_transport_required",
    "default_transport_available",
    "network_calls_permitted",
    "resolver_calls_permitted",
    "proxy_use_permitted",
    "subprocess_permitted",
    "background_threads_permitted",
    "credentials_permitted",
    "cookies_permitted",
    "javascript_permitted",
    "decompression_permitted",
    "response_parsing_permitted",
    "authority",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.scholarly_adapter.v1"},
    "schema_version": {"const": 1},
    "policy_version": {"const": "uriel.scholarly_acquisition_policy.v1"},
    "adapter_id": {"const": "local-mock-in-memory-v1"},
    "transport_kind": {"const": "LOCAL_MOCK_IN_MEMORY"},
    "injected_transport_required": {"const": true},
    "default_transport_available": {"const": false},
    "network_calls_permitted": {"const": 0},
    "resolver_calls_permitted": {"const": 0},
    "proxy_use_permitted": {"const": false},
    "subprocess_permitted": {"const": false},
    "background_threads_permitted": {"const": false},
    "credentials_permitted": {"const": false},
    "cookies_permitted": {"const": false},
    "javascript_permitted": {"const": false},
    "decompression_permitted": {"const": false},
    "response_parsing_permitted": {"const": false},
    "authority": {"const": "NONE"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
