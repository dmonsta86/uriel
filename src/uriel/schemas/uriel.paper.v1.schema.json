{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmonsta86/uriel/schemas/uriel.paper.v1.schema.json",
  "title": "Uriel Paper Manifest",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "title",
    "article_type",
    "sections"
  ],
  "properties": {
    "schema": {
      "const": "uriel.paper.v1"
    },
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "article_type": {
      "enum": [
        "empirical",
        "replication",
        "negative_result",
        "methods",
        "resource",
        "review"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "abstract",
              "introduction",
              "methods",
              "results",
              "discussion",
              "limitations",
              "conclusion",
              "statements",
              "other"
            ]
          },
          "file": {
            "type": "string",
            "pattern": "^sections/.+\\.md$"
          },
          "required": {
            "type": "boolean"
          },
          "number_policy": {
            "enum": [
              "bound",
              "cited_or_bound",
              "free"
            ]
          }
        }
      }
    },
    "word_limits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
