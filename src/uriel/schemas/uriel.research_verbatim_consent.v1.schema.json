{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmonsta86/uriel/schemas/uriel.research_verbatim_consent.v1.schema.json",
  "title": "Uriel Research Verbatim Ledger consent state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "user_isolation_key",
    "project_isolation_key",
    "mode",
    "offer_state",
    "revision",
    "transitions",
    "state_sha256"
  ],
  "properties": {
    "schema": {
      "const": "uriel.research_verbatim_consent.v1"
    },
    "schema_version": {
      "const": 1
    },
    "user_isolation_key": {
      "$ref": "#/$defs/isolation_key"
    },
    "project_isolation_key": {
      "$ref": "#/$defs/isolation_key"
    },
    "mode": {
      "enum": ["OFF", "MANUAL", "ASSISTED", "PROJECT"]
    },
    "offer_state": {
      "enum": ["UNSEEN", "OFFERED", "DECLINED", "ACCEPTED", "DISABLED"]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "transitions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "state_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "isolation_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "action",
        "from_mode",
        "to_mode",
        "from_offer_state",
        "to_offer_state",
        "created_at_utc"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": ["OFFER_SHOWN", "OFFER_DECLINED", "MODE_SELECTED", "CAPTURE_DISABLED"]
        },
        "from_mode": {
          "enum": ["OFF", "MANUAL", "ASSISTED", "PROJECT"]
        },
        "to_mode": {
          "enum": ["OFF", "MANUAL", "ASSISTED", "PROJECT"]
        },
        "from_offer_state": {
          "enum": ["UNSEEN", "OFFERED", "DECLINED", "ACCEPTED", "DISABLED"]
        },
        "to_offer_state": {
          "enum": ["UNSEEN", "OFFERED", "DECLINED", "ACCEPTED", "DISABLED"]
        },
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
