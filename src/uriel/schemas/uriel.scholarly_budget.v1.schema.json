{
  "$id": "uriel.scholarly_budget.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Scholarly Acquisition Budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_version",
    "max_request_bytes",
    "max_header_bytes",
    "max_response_bytes",
    "max_quarantine_bytes",
    "total_timeout_ms",
    "connect_timeout_ms",
    "read_timeout_ms",
    "max_retries",
    "max_dns_answers",
    "per_source_concurrency",
    "global_concurrency",
    "min_free_disk_bytes",
    "max_decompressed_bytes",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.scholarly_budget.v1"},
    "schema_version": {"const": 1},
    "policy_version": {"const": "uriel.scholarly_acquisition_policy.v1"},
    "max_request_bytes": {"type": "integer", "minimum": 256, "maximum": 65536},
    "max_header_bytes": {"type": "integer", "minimum": 256, "maximum": 65536},
    "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "max_quarantine_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "total_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "connect_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
    "read_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
    "max_retries": {"const": 0},
    "max_dns_answers": {"type": "integer", "minimum": 1, "maximum": 16},
    "per_source_concurrency": {"const": 1},
    "global_concurrency": {"const": 1},
    "min_free_disk_bytes": {"type": "integer", "minimum": 1048576, "maximum": 1073741824},
    "max_decompressed_bytes": {"const": 0},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
