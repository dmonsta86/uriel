{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "uriel.repair_packet.v1",
    "title": "Uriel constructive failure packet",
    "description": "Manifest of a standalone immutable failure packet with exact completion criteria.",
    "type": "object",
    "required": ["schema", "schema_version", "created_at_utc", "gate", "gate_name", "decision", "packet_files", "new_generation_required", "rerun_gates"],
    "properties": {
        "schema": { "const": "uriel.repair_packet.v1" },
        "schema_version": { "const": 1 },
        "created_at_utc": { "type": "string", "format": "date-time" },
        "gate": { "type": "integer", "minimum": 0, "maximum": 3 },
        "gate_name": { "type": "string" },
        "decision": {
            "type": "string",
            "enum": [
                "PASS",
                "FAIL_REFUTED",
                "FAIL_INCOMPLETE",
                "FAIL_CONTRADICTORY",
                "FAIL_UNTESTABLE",
                "FAIL_UNSUPPORTED",
                "FAIL_STALE",
                "FAIL_TAMPERED",
                "FAIL_DATA_NOT_READY",
                "FAIL_ADVERSARIAL",
                "FAIL_SCOPE_MISMATCH",
                "FAIL_NOVELTY_NOT_ESTABLISHED",
                "FAIL_REPRODUCIBILITY",
                "BLOCKED_MISSING_ACCESS",
                "BLOCKED_MISSING_ARTIFACT",
                "BLOCKED_AMBIGUOUS_IDENTITY",
                "BLOCKED_AMBIGUOUS_DEFINITION",
                "BLOCKED_EXTERNAL_VERIFICATION_REQUIRED",
                "NEEDS_CLARIFICATION",
                "NOT_APPLICABLE"
            ]
        },
        "packet_files": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 15,
            "maxItems": 15
        },
        "new_generation_required": { "type": "boolean" },
        "rerun_gates": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 3 } }
    },
    "additionalProperties": false
}
