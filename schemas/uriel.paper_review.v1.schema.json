{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmonsta86/uriel/schemas/uriel.paper_review.v1.schema.json",
  "title": "Uriel Paper Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "created_at_utc",
    "project_id",
    "project_sha256",
    "observed_source_manifest_sha256",
    "observed_source_records_sha256",
    "manuscript",
    "comparison",
    "change_gate",
    "author_fidelity",
    "claim_evidence_coverage",
    "literature_coverage",
    "recommended_action",
    "boundaries",
    "review_token",
    "report_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.paper_review.v1"},
    "schema_version": {"const": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_sha256": {"$ref": "#/$defs/sha256"},
    "observed_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "observed_source_records_sha256": {"$ref": "#/$defs/sha256"},
    "manuscript": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "first_heading"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "first_heading": {"type": "string"}
      },
      "additionalProperties": false
    },
    "comparison": {"type": "object"},
    "change_gate": {
      "type": "object",
      "required": [
        "change_class",
        "confirmation_required",
        "user_confirmed_change",
        "status",
        "canonical_mutation_performed",
        "canonical_mutation_authorized_by_uriel"
      ],
      "properties": {
        "change_class": {
          "enum": [
            "unspecified",
            "wording_only",
            "title",
            "claim_change",
            "scope_change",
            "structure_change",
            "source_change",
            "conclusion_change",
            "major_revision"
          ]
        },
        "explicit_material_class": {"type": "boolean"},
        "scale_or_title_material_signal": {"type": "boolean"},
        "confirmation_required": {"type": "boolean"},
        "user_confirmed_change": {"type": "boolean"},
        "status": {"type": "string", "minLength": 1},
        "canonical_mutation_performed": {"const": false},
        "canonical_mutation_authorized_by_uriel": {"const": false},
        "meaning": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "author_fidelity": {"type": "object"},
    "claim_evidence_coverage": {"type": "object"},
    "literature_coverage": {"type": "object"},
    "recommended_action": {"type": "string", "minLength": 1},
    "boundaries": {
      "type": "object",
      "required": [
        "advisory_only",
        "semantic_fidelity_decided",
        "scientific_truth_decided",
        "publication_authority",
        "network_requests",
        "provider_calls",
        "writes",
        "automatic_rewrite"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "semantic_fidelity_decided": {"const": false},
        "scientific_truth_decided": {"const": false},
        "publication_authority": {"const": false},
        "network_requests": {"const": 0},
        "provider_calls": {"const": 0},
        "writes": {"const": 0},
        "automatic_rewrite": {"const": false}
      },
      "additionalProperties": false
    },
    "review_token": {"type": "string", "pattern": "^upr-[0-9a-f]{32}$"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
