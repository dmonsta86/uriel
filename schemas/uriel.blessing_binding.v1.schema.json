{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "uriel.blessing_binding.v1",
    "title": "Uriel strict Blessing binding",
    "description": "The exact-version binding recomputed by the independent verifier before any certificate exists.",
    "type": "object",
    "required": [
        "policy",
        "gate_specification_versions",
        "project_manifest_sha256",
        "source_manifest_sha256",
        "source_records_sha256",
        "source_manifest_verified",
        "data_readiness_receipt_sha256s",
        "limitation_register",
        "binding_digest"
    ],
    "properties": {
        "policy": { "type": "string" },
        "gate_specification_versions": { "type": "string" },
        "project_manifest_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "source_manifest_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "source_records_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "source_manifest_verified": { "type": "boolean" },
        "data_readiness_receipt_sha256s": { "type": "array", "items": { "type": "string", "minLength": 64, "maxLength": 64 } },
        "limitation_register": { "type": "array", "items": { "type": "string" } },
        "binding_digest": { "type": "string", "minLength": 64, "maxLength": 64 }
    },
    "additionalProperties": false
}
