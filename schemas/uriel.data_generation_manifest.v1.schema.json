{
  "$id": "uriel.data_generation_manifest.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Data Generation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "created_at_utc",
    "generation_id",
    "parent_generation_id",
    "raw_artifact_sha256s",
    "transform_receipt_sha256s",
    "reconciliation_sha256",
    "record_count",
    "records_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.data_generation_manifest.v1"},
    "schema_version": {"const": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_generation_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "raw_artifact_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "transform_receipt_sha256s": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "reconciliation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
