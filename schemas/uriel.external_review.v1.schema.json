{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uriel.dev/schemas/uriel.external_review.v1.schema.json",
  "title": "Uriel External Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "task",
    "reviewer_type",
    "provider",
    "model",
    "created_at_utc",
    "source_manifest_sha256",
    "project_manifest_sha256",
    "scope",
    "findings",
    "limitations",
    "conclusion"
  ],
  "properties": {
    "schema": {
      "const": "uriel.external_review.v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "task": {
      "enum": [
        "clarity",
        "field-map",
        "primary-evidence",
        "contradiction-review",
        "adversarial-review",
        "repair-review",
        "submission-review"
      ]
    },
    "reviewer_type": {
      "enum": [
        "human",
        "ai",
        "hybrid"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "statement",
          "evidence_refs",
          "source_locators",
          "repair_options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "blocker"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 12
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_locators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repair_options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    }
  }
}
