{
  "$id": "uriel.scholarly_quarantine.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Scholarly Raw-Byte Quarantine v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "created_at_utc",
    "policy_version",
    "plan_record_sha256",
    "request_descriptor_sha256",
    "source_id",
    "mock_scenario_id",
    "response_status",
    "media_type",
    "response_headers",
    "headers_sha256",
    "body_content_sha256",
    "body_size_bytes",
    "managed_relative_path",
    "complete",
    "raw_untrusted",
    "parsed",
    "decoded",
    "instructions_followed",
    "immutable",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.scholarly_quarantine.v1"},
    "schema_version": {"const": 1},
    "created_at_utc": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_version": {"const": "uriel.scholarly_acquisition_policy.v1"},
    "plan_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_descriptor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"const": "mock.scholarly-metadata.v1"},
    "mock_scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "response_status": {"const": 200},
    "media_type": {"const": "application/json"},
    "response_headers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": {"enum": ["content-encoding", "content-length", "content-type"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "headers_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "managed_relative_path": {"type": "string", "minLength": 1, "maxLength": 256},
    "complete": {"const": true},
    "raw_untrusted": {"const": true},
    "parsed": {"const": false},
    "decoded": {"const": false},
    "instructions_followed": {"const": false},
    "immutable": {"const": true},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
