{
  "$id": "https://uriel.dev/schemas/uriel.ephemeral_policy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at_utc": {
      "type": "string"
    },
    "exclusions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy_version": {
      "type": "string"
    },
    "schema": {
      "const": "uriel.ephemeral_policy.v1"
    }
  },
  "required": [
    "schema",
    "policy_version",
    "created_at_utc",
    "exclusions"
  ],
  "title": "Uriel Ephemeral Policy",
  "type": "object"
}
