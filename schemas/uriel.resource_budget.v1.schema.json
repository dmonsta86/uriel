{
  "$id": "uriel.resource_budget.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Data Desk Resource Budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_version",
    "max_source_bytes",
    "max_records",
    "max_columns",
    "max_nesting_depth",
    "timeout_seconds",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.resource_budget.v1"},
    "schema_version": {"const": 1},
    "policy_version": {"const": "uriel.data_policy.v1"},
    "max_source_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
    "max_records": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "max_columns": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "max_nesting_depth": {"type": "integer", "minimum": 1, "maximum": 1024},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
