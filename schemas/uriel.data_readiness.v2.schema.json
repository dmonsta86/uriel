{
  "$id": "uriel.data_readiness.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel generation-bound Data Readiness receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_version",
    "data_policy_version",
    "normalizer_version",
    "generation_id",
    "generation_manifest_sha256",
    "parser_version",
    "parent_generation_ids",
    "operation_binding_sha256",
    "raw_artifact_sha256s",
    "records_sha256",
    "source_order_sha256",
    "records_file_sha256",
    "normalized_generation",
    "sort_spec_sha256",
    "analysis_plan_sha256",
    "required_check_count",
    "executed_check_count",
    "passed_check_count",
    "failed_check_count",
    "blocked_check_count",
    "unresolved_blocker_count",
    "not_applicable_count",
    "decision",
    "binding_digest",
    "checks",
    "independent_generation_verification",
    "no_authority_from_ai",
    "record_sha256"
  ],
  "properties": {
    "schema": { "const": "uriel.data_readiness.v2" },
    "schema_version": { "const": 2 },
    "policy_version": { "const": "uriel.data_readiness_policy.v2" },
    "data_policy_version": { "const": "uriel.data_policy.v1" },
    "normalizer_version": { "const": "uriel.data_readiness_normalizer.v1" },
    "generation_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generation_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parser_version": { "const": "uriel.data_parser.v1" },
    "parent_generation_ids": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "operation_binding_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "raw_artifact_sha256s": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "records_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_order_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "records_file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "normalized_generation": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
    "sort_spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "analysis_plan_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "required_check_count": { "const": 22 },
    "executed_check_count": { "const": 22 },
    "passed_check_count": { "type": "integer", "minimum": 0, "maximum": 22 },
    "failed_check_count": { "type": "integer", "minimum": 0, "maximum": 22 },
    "blocked_check_count": { "type": "integer", "minimum": 0, "maximum": 22 },
    "unresolved_blocker_count": { "type": "integer", "minimum": 0, "maximum": 22 },
    "not_applicable_count": { "const": 0 },
    "decision": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "binding_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "evidence"],
        "properties": {
          "check_id": {
            "enum": [
              "source_identity",
              "record_identity",
              "schema",
              "encoding",
              "type_normalization",
              "datetime_normalization",
              "numeric_locale",
              "category_normalization",
              "duplicate_handling",
              "join_keys_and_cardinality",
              "missingness",
              "exclusions",
              "transformations",
              "stable_deterministic_sorting",
              "tie_break_rules",
              "null_ordering",
              "order_invariance",
              "row_reconciliation",
              "cross_platform_fixture_equivalence",
              "rebuild_hash_equality",
              "analysis_plan_binding",
              "independent_verification"
            ]
          },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "evidence": { "type": "object" }
        }
      }
    },
    "independent_generation_verification": { "const": "PASS" },
    "no_authority_from_ai": { "const": true },
    "record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
