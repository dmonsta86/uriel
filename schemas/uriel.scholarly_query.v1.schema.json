{
  "$id": "uriel.scholarly_query.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uriel Structured Scholarly Query v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_version",
    "source_id",
    "terms",
    "year_from",
    "year_to",
    "max_results",
    "free_form_url_supplied",
    "ai_role",
    "authority",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "uriel.scholarly_query.v1"},
    "schema_version": {"const": 1},
    "policy_version": {"const": "uriel.scholarly_acquisition_policy.v1"},
    "source_id": {"const": "mock.scholarly-metadata.v1"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "year_from": {"type": ["integer", "null"], "minimum": 1000, "maximum": 3000},
    "year_to": {"type": ["integer", "null"], "minimum": 1000, "maximum": 3000},
    "max_results": {"type": "integer", "minimum": 1, "maximum": 100},
    "free_form_url_supplied": {"const": false},
    "ai_role": {"const": "STRUCTURED_FIELDS_ONLY"},
    "authority": {"const": "NONE"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
